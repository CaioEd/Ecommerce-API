		{
			"name": "Health",
			"item": [
				{
					"name": "Healthcheck",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('responde status ok', function () {",
									"    pm.expect(pm.response.json().status).to.eql('ok');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Fica fora do grupo versionado `/api/v1`."
					},
					"response": []
				}
			]
		},
		{
			"name": "Usuários",
			"item": [
				{
					"name": "Criar usuário",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// E-mail único por execução para a collection poder rodar quantas vezes quiser.",
									"pm.collectionVariables.set('userEmail', 'teste+' + Date.now() + '@example.com');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"const body = pm.response.json();",
									"pm.collectionVariables.set('userId', body.id);",
									"",
									"pm.test('devolve o id gerado', function () {",
									"    pm.expect(body.id).to.be.a('number');",
									"});",
									"",
									"pm.test('não expõe o hash da senha', function () {",
									"    pm.expect(body).to.not.have.property('password');",
									"});",
									"",
									"pm.test('devolve os campos do UserResponse', function () {",
									"    pm.expect(body).to.have.all.keys('id', 'name', 'email', 'role', 'created_at', 'updated_at');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Caio Silva\",\n    \"email\": \"{{userEmail}}\",\n    \"password\": \"senha123\",\n    \"role\": \"customer\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"users"
							]
