# Servidor
SERVER_PORT=8080

# Banco de dados (PostgreSQL)
# Estas mesmas variáveis são consumidas pelo docker-compose.yml para criar o
# container, então a API e o banco nunca saem de sincronia.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce
DB_SSLMODE=disable

# Timezone do container do Postgres
TZ=America/Sao_Paulo
